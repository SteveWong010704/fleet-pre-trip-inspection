# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: password for the primary admin "steve", used ONLY when that account
# has no password yet (first run). If unset, a random one is generated and printed once.
# It is NOT a shared login for other accounts.
ADMIN_PASSWORD=""
# To recover a forgotten steve password: set RESET_ADMIN_PASSWORD=true together with
# ADMIN_PASSWORD (min 8 chars), restart once, then remove RESET_ADMIN_PASSWORD again.
RESET_ADMIN_PASSWORD=""

# MASTER_SECURITY_PASSWORD: authorizes destructive actions (wipe data, reset QR tokens,
# change public URL). REQUIRED: while unset those actions are disabled.
MASTER_SECURITY_PASSWORD=""

# HASH_PASSWORDS: set to true to store driver/staff passwords as scrypt hashes
# (plaintext passwords are upgraded automatically at each account's next login).
# Leave unset until the new version has been running stably - old code cannot read hashes.
HASH_PASSWORDS=""

# JWT_SECRET: 256-bit cryptographically secure key for signing session tokens
# If unset, the server generates and persists a persistent random secret automatically in data/.jwt_secret
JWT_SECRET=""

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Mode Selection:
# DB_TYPE="mssql"  --> Connects to SQL Server (for Production & Testing)
# DB_TYPE="json"   --> Pure offline local JSON mode (for .80 machine, no SQL needed)
DB_TYPE="mssql"

# Server IP or Hostname (e.g. 192.168.1.215 or localhost)
MSSQL_SERVER="192.168.1.215"
MSSQL_PORT="1433"
MSSQL_USER="sa"
MSSQL_PASSWORD="change-me"

# Database Target:
# Production:  MSSQL_DATABASE="FleetInspectionDB"
# Testing:     MSSQL_DATABASE="FleetInspectionDB_Test"
MSSQL_DATABASE="FleetInspectionDB"
MSSQL_ENCRYPT="false"

